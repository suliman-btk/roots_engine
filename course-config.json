{
  "courseId": "ROOTS",
  "lessonLabelTemplate": "ROOTS · Lesson {lesson}",

  "brand": {
    "watermarkLogo": "nama-logo-white.png",
    "watermarkLogoColored": "nama-logo.png",
    "titleLogo": "roots-logo.png",
    "watermarkStyle": "standard",
    "accentElement": "baseline"
  },

  "theme": {
    "colors": {
      "navy": "#020181",
      "deep": "#01005F",
      "mid": "#25258F",
      "surface": "#F7F7FB",
      "accent": "#CDAC3B",
      "accentLight": "#E4C862",
      "cream": "#FFFFFF",
      "sand": "#F4F1DF",
      "panel": "rgba(255,255,255,0.92)",
      "panelEdge": "rgba(2,1,129,0.18)",
      "inkDim": "rgba(1,0,95,0.68)",
      "plumSafe": "#EEEEFA",
      "tealSafe": "#F7F2DF"
    },
    "headingFamily": "\"Inter\", \"Segoe UI\", Helvetica, Arial, sans-serif",
    "bodyFamily": "\"Inter\", \"Segoe UI\", Helvetica, Arial, sans-serif",
    "headingWeight": 700,
    "type": { "hero": 58, "title": 38, "cardTitle": 28, "body": 22, "label": 16 },
    "radius": { "card": 999, "chip": 999, "video": 24 }
  },

  "presenterGrammar": {
    "fullBleedTarget": 0.35,
    "splitWidthPct": 30,
    "minTurnSeconds": 2.0,
    "requireSideAlternation": true,
    "requireFullBleedBetweenSides": true,
    "softPushAmplitude": 0.05
  },

  "transitions": {
    "defaultTransition": "crossfade",
    "sectionTransition": "dip-to-brand"
  }
}
